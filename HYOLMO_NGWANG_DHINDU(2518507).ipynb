      "source": [
        "### **11.5 Handling errors in file operations**\n",
        "\n",
        "Use try/except to handle missing files or IO errors."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "794279cf",
      "metadata": {
        "id": "794279cf"
      },
      "outputs": [],
      "source": [
        "try:\n",
        "    with open('nofile.txt') as f:\n",
        "        print(f.read())\n",
        "except FileNotFoundError:\n",
        "    print('File not found')"
      ]
