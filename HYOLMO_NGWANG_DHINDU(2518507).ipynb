      "metadata": {
        "id": "74ba1c74"
      },
      "source": [
        "### **11.4 Using with open() context manager**\n",
        "\n",
        "Use `with` to auto-close files even on error."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "dc38a92a",
      "metadata": {
        "id": "dc38a92a"
